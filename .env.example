NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/departmental-portal

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ONBOARDING_TOKEN_EXPIRES_IN=15m
PASSWORD_RESET_EXPIRES_MINUTES=30
BCRYPT_ROUNDS=12

# Resend (required in production; in development emails are printed to the console if unset)
RESEND_API_KEY=
EMAIL_FROM=

# Frontend origin(s). Comma-separate several. The first one is used in email links.
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the app (0 = none). Needed for correct rate limiting behind a proxy.
TRUST_PROXY=0

# Cloudinary (profile photos). Required in production; in development photo upload returns 503 if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_PROFILE_PHOTO_MB=2
MAX_SUBMISSION_MB=10

# Attendance security
ATTENDANCE_CHALLENGE_TTL_SECONDS=90
ATTENDANCE_MAX_ACCURACY_METERS=100
# Lecturer setting the venue (higher = more forgiving, but the venue centre gets less precise; max 1000)
ATTENDANCE_CREATOR_MAX_ACCURACY_METERS=100
DEVICE_CHANGE_LIMIT_30D=2
DEVICE_VERIFICATION_TTL_MINUTES=10

# Class resources uploaded by representatives
MAX_RESOURCE_MB=15

# Web push (leave all three empty to keep browser push off; in-app notifications always work).
# Generate keys once:  npx web-push generate-vapid-keys   (keep the private key secret; never commit it)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:portal-admin@your-university.edu
# Extra browser push hosts to accept, comma-separated (the built-in list covers Chrome/Edge, Firefox and Safari)
PUSH_EXTRA_ENDPOINT_HOSTS=
PUSH_MAX_DEVICES_PER_USER=10

# Picture attached to an announcement (HOD / lecturer / course rep)
MAX_ANNOUNCEMENT_IMAGE_MB=5

# Real-time notifications over Socket.IO (same CORS origins as the API)
SOCKET_ENABLED=true
SOCKET_MAX_SESSION_MINUTES=60

# Attendance location tolerance: GPS error (your accuracy + the venue's) may widen the allowed radius by at most this many metres (0 = strict)
ATTENDANCE_ACCURACY_ALLOWANCE_MAX_METERS=50
# Show a rejected student roughly how far away they appeared to be
ATTENDANCE_SHOW_DISTANCE=true

# AI writing assistant for complaints ("Improve with AI"). Leave the keys empty to switch it off (the button should then be hidden).
# FREE option: a Google Gemini key from https://aistudio.google.com/apikey (no card needed; rate limits apply).
# Paid option: an Anthropic key from https://console.anthropic.com
# AI_PROVIDER is optional: when empty, whichever key is set is used (Gemini first).
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-2.5-flash-lite (Gemini) / claude-haiku-5-5 (Anthropic).
AI_MODEL=
AI_TIMEOUT_MS=25000
# Time zone for the date on an AI-drafted letter (IANA name)
PORTAL_TIMEZONE=Africa/Lagos
