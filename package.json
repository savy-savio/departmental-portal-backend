{
  "name": "departmental-portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-department university portal backend (Student phase)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate:rep-levels": "tsx src/scripts/migrate-rep-levels.ts",
    "reminders:deadlines": "tsx src/scripts/send-deadline-reminders.ts",
    "seed:departments": "tsx src/seeders/seed-departments.ts",
    "seed:students": "tsx src/seeders/seed-students.ts",
    "seed:terms": "tsx src/seeders/seed-terms.ts",
    "seed:courses": "tsx src/seeders/seed-courses.ts",
    "seed:content": "tsx src/seeders/seed-content.ts",
    "seed:elections": "tsx src/seeders/seed-elections.ts",
    "seed:representatives": "tsx src/seeders/seed-representatives.ts",
    "seed:lecturers": "tsx src/seeders/seed-lecturers.ts",
    "seed:hods": "tsx src/seeders/seed-hods.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
